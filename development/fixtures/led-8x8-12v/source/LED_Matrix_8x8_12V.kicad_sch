  (text "8x8 RED LED ARRAY / 12 V DC / 60 x 60 mm / SINGLE COPPER SIDE"
    (at 15.24 8.89 0)
    (effects (font (size 1.5 1.5) (bold yes)) (justify left bottom))
    (uuid "bc9076c5-aa92-4b73-9f8d-d33b0acb608b")
  )
  (text "16 parallel branches: 4 series LEDs + 1k / 1% / 1206 / 0.25W each.\nLED: Wurth 150283RS73103, pin 1 = A, pin 2 = K.\nJ1 TOP / J2 RIGHT / J3 BOTTOM / J4 LEFT; pin 1 = +12V, pin 2 = GND.\nRegulated 12V supply. Low-current workflow test; verify real current and brightness on prototype."
    (at 243.84 236.22 0)
    (effects (font (size 1 1)) (justify left bottom))
    (uuid "bfe86651-ab61-429e-a037-8a09d2d7d5e6")
  )
